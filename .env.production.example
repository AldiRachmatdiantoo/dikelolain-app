# Salin menjadi .env di server, lalu isi. Langkah lengkap ada di DEPLOY.md.
APP_NAME=Dikelolain
APP_ENV=production
# Dibuat otomatis oleh scripts/deploy.sh. Jangan diganti setelah situs berjalan.
APP_KEY=
APP_DEBUG=false
# Alamat asli situs. Awali dengan https:// agar semua link dan aset memakai HTTPS.
APP_URL=https://domain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Akun admin pertama, dibuat oleh `php artisan db:seed --force`.
# Kosongkan ADMIN_PASSWORD agar seeder membuat password acak dan menampilkannya sekali.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@domain-anda.com
ADMIN_PASSWORD=

LOG_STACK=daily
LOG_LEVEL=warning

# SQLite: tidak perlu diisi lagi, file dibuat di database/database.sqlite.
DB_CONNECTION=sqlite
# MySQL: hapus baris di atas, lalu buka dan isi baris di bawah.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dikelolain
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookie login hanya dikirim lewat HTTPS.
SESSION_SECURE_COOKIE=true

CACHE_STORE=database

# Isi hanya bila hosting menaruh proxy di depan situs (Azure, Cloudflare, load balancer):
# * untuk proxy mana pun, atau daftar IP dipisah koma. Kosongkan bila server langsung menghadap internet.
TRUSTED_PROXIES=
